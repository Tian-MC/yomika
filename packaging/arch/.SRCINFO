pkgbase = vn-launcher-git
	pkgdesc = Linux-first visual novel launcher (Wine/Proton/umu, text hooking, translation)
	pkgver = 0.1.0.r1.gf97cb60
	pkgrel = 1
	url = https://example.invalid/vn-launcher
	arch = x86_64
	arch = aarch64
	license = LicenseRef-TBD
	makedepends = cargo
	makedepends = git
	makedepends = nodejs
	makedepends = npm
	depends = cairo
	depends = gcc-libs
	depends = gdk-pixbuf2
	depends = glib2
	depends = glibc
	depends = gtk3
	depends = hicolor-icon-theme
	depends = libsoup3
	depends = pango
	depends = webkit2gtk-4.1
	optdepends = wine: run Windows games with the system Wine
	optdepends = umu-launcher: run games with Proton outside Steam (recommended runner)
	optdepends = winetricks: install runtime components (vcrun, d3dx9, fonts) into prefixes
	optdepends = gamescope: nested compositor with fixed resolution and FSR/NIS upscaling
	optdepends = tesseract: OCR text extraction
	optdepends = tesseract-data-jpn: Japanese language data for OCR
	optdepends = ollama: local LLM translation backend
	optdepends = imagemagick: screenshot preprocessing for OCR
	optdepends = wl-clipboard: clipboard text source on Wayland
	optdepends = xclip: clipboard text source on X11
	optdepends = noto-fonts-cjk: Japanese/CJK fonts
	optdepends = lib32-vulkan-icd-loader: 32-bit Vulkan for DXVK in 32-bit games (also install the lib32 driver: lib32-mesa, lib32-vulkan-radeon or lib32-nvidia-utils)
	provides = vn-launcher
	conflicts = vn-launcher
	options = !lto
	source = vn-launcher::git+https://example.invalid/vn-launcher.git
	sha256sums = SKIP

pkgname = vn-launcher-git
