<component type="desktop-application">
  <id>io.github.yomika.Yomika</id>
  <metadata_license>CC0-1.0</metadata_license>
  <!-- The project license is not decided yet; update this (and Cargo/PKGBUILD) once chosen. -->
  <project_license>LicenseRef-TBD</project_license>

  <name>Yomika</name>
  <summary>Linux-first launcher for visual novels</summary>
  <developer id="io.github.yomika">
    <name>Yomika contributors</name>
  </developer>

  <description>
    <p>
      Yomika organises a visual novel library and runs Windows titles through Wine, Proton
      or umu-launcher with per-game prefixes, locale and runtime settings.
    </p>
    <p>Features:</p>
    <ul>
      <li>Library with VNDB metadata, playtime tracking and save backups</li>
      <li>Per-game Wine/Proton runner, prefix, Japanese locale and environment settings</li>
      <li>Optional gamescope integration and Wine FSR upscaling</li>
      <li>Text extraction via hooking, clipboard or OCR, with local (Ollama) or online translation</li>
    </ul>
    <p>
      Wine, Proton, gamescope, Tesseract and Ollama are optional external programs and are not bundled.
    </p>
  </description>

  <launchable type="desktop-id">io.github.yomika.Yomika.desktop</launchable>
  <provides>
    <binary>yomika</binary>
  </provides>

  <url type="homepage">https://github.com/Tian-MC/yomika</url>
  <url type="bugtracker">https://github.com/Tian-MC/yomika/issues</url>

  <categories>
    <category>Game</category>
  </categories>
  <keywords>
    <keyword>visual novel</keyword>
    <keyword>wine</keyword>
    <keyword>proton</keyword>
    <keyword>translation</keyword>
  </keywords>

  <content_rating type="oars-1.1"/>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <requires>
